# Sentry 错误监控 DSN
VITE_SENTRY_DSN=

# 应用版本号
VITE_APP_VERSION=1.0.0

# 应用名称
VITE_APP_NAME=新能源编程俱乐部

# 应用描述
VITE_APP_DESCRIPTION=通过协作开发构建可持续技术

# 后端 API 基础地址
VITE_API_BASE_URL=http://localhost:3001/api

# 站点 AI 助手：mintlify（默认，Mintlify 官方 Widget）或 dify（自建 Dify 机器人）
VITE_ASSISTANT_PROVIDER=mintlify
# Dify 应用「嵌入网站」token（provider=dify 时必填）
VITE_DIFY_EMBED_TOKEN=
# Dify 地址：云服务 https://udify.app，自托管填自有域名
VITE_DIFY_BASE_URL=https://udify.app

# Feishu (Lark) 成员加入表单 -> 多维表写入
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_JOIN_BASE_APP_TOKEN=
FEISHU_JOIN_TABLE_ID=
FEISHU_JOIN_FIELD_NAME=
FEISHU_JOIN_FIELD_EMAIL=
FEISHU_JOIN_FIELD_PHONE=
FEISHU_JOIN_FIELD_ORG=
FEISHU_JOIN_FIELD_ROLE=
FEISHU_JOIN_FIELD_BIO=
FEISHU_JOIN_FIELD_TECH_STACK=
FEISHU_JOIN_FIELD_SOURCE=
